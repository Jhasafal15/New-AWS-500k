{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "S3Bucket",
  "type": "object",
  "required": ["bucket_name", "arn", "region", "creation_date", "is_public", "encryption_enabled", "versioning_enabled"],
  "properties": {
    "bucket_name": { "type": "string" },
    "arn": { "type": "string" },
    "region": { "type": "string" },
    "creation_date": { "type": "string" },
    "is_public": { "type": "boolean" },
    "acl_grants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "grantee_type": { "type": "string" },
          "permission": { "type": "string" }
        }
      }
    },
    "public_access_block": {
      "type": "object",
      "properties": {
        "block_public_acls": { "type": "boolean" },
        "ignore_public_acls": { "type": "boolean" },
        "block_public_policy": { "type": "boolean" },
        "restrict_public_buckets": { "type": "boolean" }
      }
    },
    "encryption_enabled": { "type": "boolean" },
    "kms_master_key_id": { "type": ["string", "null"] },
    "server_side_encryption_algorithm": { "type": ["string", "null"] },
    "versioning_enabled": { "type": "boolean" },
    "logging_enabled": { "type": "boolean" },
    "bucket_policy": { "type": ["object", "null"] },
    "tags": { "type": "object" }
  }
}
